# Database
# DB명은 pcb_inspection_db (pcb_inspection 아님 주의), postgres 비밀번호로 교체
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/pcb_inspection_db"

# MinIO
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="pcb-images"
MINIO_SECURE=false

# MLflow
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="pcb-inspection"

# AI Models
MODEL_PATH="./models"
DEFAULT_MODEL_NAME="pcb_detector_v1"

# GPU
USE_GPU=true
GPU_DEVICE_ID=0

# JWT
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI (RCA 이미지 기반 불량 진단)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_MODEL=gpt-4o
